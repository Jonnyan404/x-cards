{
  "icons": {
    "16": "icon16.plasmo.6c567d50.png",
    "32": "icon32.plasmo.76b92899.png",
    "48": "icon48.plasmo.aced7582.png",
    "64": "icon64.plasmo.8bb5e6e0.png",
    "128": "icon128.plasmo.3c1ed2d2.png"
  },
  "manifest_version": 3,
  "action": {
    "default_icon": {
      "16": "icon16.plasmo.6c567d50.png",
      "32": "icon32.plasmo.76b92899.png",
      "48": "icon48.plasmo.aced7582.png",
      "64": "icon64.plasmo.8bb5e6e0.png",
      "128": "icon128.plasmo.3c1ed2d2.png"
    }
  },
  "version": "1.0.0",
  "author": "yixtotieq@gmail.com",
  "name": "Tweet Cards",
  "description": "Turn tweets into beautiful cards on X. Pick the card server you trust, or point the extension at your own self-hosted one.",
  "background": {
    "service_worker": "static/background/index.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "plasmo-overlay.74e3e808.js"
      ],
      "css": []
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-home.da5e1177.js"
      ],
      "run_at": "document_end",
      "css": []
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "resources": [
        "plasmo-overlay.636365f5.css"
      ]
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "resources": [
        "x-home.52ed707b.css"
      ]
    }
  ]
}
